# Copy to .env and adjust. The agent runs without any .env (deterministic mode).

# --- LLM (optional) ---------------------------------------------------------
# When set, --mode auto uses Claude for vision + message generation.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=60
# Validation-feedback retries before falling back to the deterministic generator.
LLM_MAX_RETRIES=2

# --- Generation -------------------------------------------------------------
OUTPUT_LANGUAGE=vi
# Target number of rapport messages (5-10).
DEFAULT_MESSAGE_COUNT=10

# --- Data acquisition -------------------------------------------------------
# Opt-in single public-meta GET to facebook.com (same as --live). Never logs in.
LIVE_FETCH_ENABLED=false
# Directory searched for provided profile JSON matched by URL.
PROFILE_STORE_DIR=fixtures/profiles
# Minimum non-name facts required for a SUCCESS result.
MIN_GROUNDING_FACTS=2
