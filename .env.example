# Copy to .env and adjust. The agent runs without any .env (deterministic mode).

# --- LLM (optional) ---------------------------------------------------------
# With a key, --mode auto uses an LLM for vision + message generation; without one, templates are used.
# LLM_PROVIDER: auto (Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set) | anthropic | gemini
LLM_PROVIDER=auto
# Claude (Anthropic API, requires billing)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Gemini (Google AI Studio key, free tier available: https://aistudio.google.com/apikey).
# Free-tier content may be used by Google to improve its products: use only test / consented data on the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary model is overloaded (503), out of quota (429), missing or timing out.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=60
# Validation-feedback retries before falling back to the deterministic generator.
LLM_MAX_RETRIES=2

# --- Generation -------------------------------------------------------------
OUTPUT_LANGUAGE=vi
# Target number of rapport messages (5-10).
DEFAULT_MESSAGE_COUNT=10

# --- Data acquisition -------------------------------------------------------
# Opt-in single public-meta GET to facebook.com (same as --live). Never logs in.
LIVE_FETCH_ENABLED=false
# Directory searched for provided profile JSON matched by URL.
PROFILE_STORE_DIR=fixtures/profiles
# Minimum non-name facts required for a SUCCESS result.
MIN_GROUNDING_FACTS=2
