# Copy to .env and adjust. The agent runs without any .env (deterministic mode). Details: README section 3.

# --- LLM (optional; without a key the deterministic template generator is used) ---
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Generation ---
OUTPUT_LANGUAGE=vi
DEFAULT_MESSAGE_COUNT=10

# --- Data acquisition (see README section 10) ---
PUBLIC_BROWSER_ENABLED=true
LIVE_FETCH_ENABLED=false
PROFILE_STORE_DIR=fixtures/profiles
MIN_GROUNDING_FACTS=2
